{
  "name": "jacerider/grumphp-drupal",
  "type": "composer-plugin",
  "description": "GrumPHP + tools for Drupal",
  "require": {
    "composer-plugin-api": "^2.0",
    "phpro/grumphp": "^2.0",
    "squizlabs/php_codesniffer": "^3.4",
    "drupal/coder": "^8.3",
    "mglaman/phpstan-drupal": "^2.0"
  },
  "extra": {
    "class": "jacerider\\GrumPhpDrupal\\Composer\\Plugins\\GrumPhpConfiguratorPlugin"
  },
  "autoload": {
    "psr-4": {
      "jacerider\\GrumPhpDrupal\\": "src/"
    }
  }
}
